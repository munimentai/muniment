{
  "name": "muniment-editor",
  "displayName": "Muniment",
  "description": "Muniment editor companion.",
  "version": "0.0.1",
  "private": true,
  "publisher": "muniment",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikeydiamonds/muniment-desktop.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:muniment.threads",
    "onCommand:muniment.refreshThreads",
    "onCommand:muniment.newRun",
    "onCommand:muniment.newRunWithCurrentFile",
    "onCommand:muniment.openThread"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "muniment.refreshThreads",
        "title": "Refresh Threads",
        "icon": "$(refresh)"
      },
      {
        "command": "muniment.openThread",
        "title": "Open Thread",
        "category": "Muniment"
      },
      {
        "command": "muniment.newRun",
        "title": "New Run",
        "category": "Muniment",
        "icon": "$(add)"
      },
      {
        "command": "muniment.newRunWithCurrentFile",
        "title": "New Run with Current File",
        "category": "Muniment"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "muniment",
          "title": "Muniment",
          "icon": "media/muniment.svg"
        }
      ]
    },
    "views": {
      "muniment": [
        {
          "id": "muniment.threads",
          "name": "Threads",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "muniment.threads",
        "contents": "Loading recent threads…",
        "when": "muniment.threadsState == loading"
      },
      {
        "view": "muniment.threads",
        "contents": "Approve the connection in Muniment to continue.",
        "when": "muniment.threadsState == pairing"
      },
      {
        "view": "muniment.threads",
        "contents": "No recent threads.\n[Refresh](command:muniment.refreshThreads)",
        "when": "muniment.threadsState == empty"
      },
      {
        "view": "muniment.threads",
        "contents": "Muniment isn’t available. Open the desktop app, then try again.\n[Refresh](command:muniment.refreshThreads)",
        "when": "muniment.threadsState == runtime-unavailable"
      },
      {
        "view": "muniment.threads",
        "contents": "Couldn’t connect securely to Muniment.\n[Try Again](command:muniment.refreshThreads)",
        "when": "muniment.threadsState == connection-failed"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "muniment.newRun",
          "when": "view == muniment.threads",
          "group": "navigation@1"
        },
        {
          "command": "muniment.refreshThreads",
          "when": "view == muniment.threads",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "muniment.newRunWithCurrentFile",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.3"
  }
}
