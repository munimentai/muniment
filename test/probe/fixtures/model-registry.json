  "classifiers": {
    "entries": [
      {
        "id": "jev",
        "name": "Jev",
        "model": "jev-latest",
        "note": "Hosted decision model. Choose where your routing requests go.",
        "methods": [
          "typesafe",
          "openrouter",
          "cloudflare",
          "server"
        ]
      },
      {
        "id": "clef",
        "name": "Clef",
        "model": "clef-flash",
        "note": "Cloudflare's decision models. Clef Flash is the fast, inexpensive one. Clef is the larger, more accurate one.",
        "methods": [
          "cloudflare",
          "ollama",
          "openrouter"
        ],
        "variants": [
          {
            "id": "clef-flash",
            "name": "Clef Flash",
            "models": {
              "cloudflare": "@cf/cloudflare/clef-flash",
              "ollama": "clef-flash",
              "openrouter": "cloudflare/clef-flash"
            }
          },
          {
            "id": "clef",
            "name": "Clef",
            "models": {
              "cloudflare": "@cf/cloudflare/clef",
              "ollama": "clef",
              "openrouter": "cloudflare/clef"
            }
          }
        ]
      },
      {
        "id": "luna",
        "name": "GPT-6 Luna",
        "model": "gpt-6-luna",
        "note": "OpenAI's decision model. It needs an OpenAI API key, because a ChatGPT sign-in does not reach the Decisions API.",
        "methods": [
          "openai"
        ]
      },
      {
        "id": "kev",
        "name": "Kev",
        "repo": "https://github.com/jaredpalmer/kev",
        "model": "kev-latest",
        "note": "Local decision models in several sizes. The server downloads the checkpoint and base model on first use.",
        "compatible": true,
        "methods": [
          "server",
          "download"
        ]
      },
      {
        "id": "nimble",
        "name": "Nimble",
        "repo": "https://github.com/bespokelabsai/nimble",
        "model": "nimble",
        "note": "A 9B decision model. Ollama serves it, or run its own System One server.",
        "compatible": true,
        "methods": [
          "ollama",
          "server",
          "download"
        ]
      },
      {
        "id": "von",
        "name": "Von",
        "repo": "https://github.com/wfzyx/von",
        "model": "von-1.3.0",
        "note": "A small English decision model that runs on a CPU.",
        "compatible": true,
        "methods": [
          "server",
          "download"
        ]
      },
      {
        "id": "laya",
        "name": "Laya",
        "repo": "https://github.com/NandhaKishorM/laya",
        "model": "english",
        "note": "Very fast on a CPU, and less accurate at picking a model. The server downloads weights on first use.",
        "compatible": true,
        "methods": [
          "server",
          "download"
        ]
      },
      {
        "id": "decider",
        "name": "Decider 4B",
        "repo": "https://github.com/Mapika/decider",
        "model": "Mapika/decider-4b",
        "note": "Runs on CPU, Apple Silicon or CUDA. The 4B weights need about 8 GB in bfloat16.",
        "compatible": true,
        "methods": [
          "server",
          "download"
        ]
      }
    ],
    "methods": {
      "typesafe": {
        "name": "TypeSafe API",
        "url": "https://api.typesafe.ai/v1/systemone",
        "model": "jev-latest",
        "key": true
      },
      "openrouter": {
        "name": "OpenRouter API",
        "url": "https://openrouter.ai/api/v1/systemone",
        "model": "typesafe/jev-1.13",
        "key": true
      },
      "openai": {
        "name": "OpenAI API",
        "url": "https://api.openai.com/v1/decisions",
        "model": "gpt-6-luna",
        "key": true
      },
      "cloudflare": {
        "name": "Cloudflare Workers AI",
        "model": "typesafe/jev",
        "key": true,
        "guide": "https://developers.cloudflare.com/ai/models/typesafe/jev/"
      },
      "ollama": {
        "name": "Ollama server",
        "ollama": true
      },
      "server": {
        "name": "Connect a server",
        "url": "http://127.0.0.1:8000/v1/systemone"
      },
      "download": {
        "name": "Download and run locally"
      }
    },
    "localSetup": {
      "laya": "pip install \"laya[serve]\"\nLAYA_MODELS=english laya-serve",
      "kev": "git clone https://github.com/jaredpalmer/kev.git\ncd kev\nuv sync --extra serve\nuv run --extra serve python -m kev.serve --run jaredpalmer/kev-4b --port 8009",
      "decider": "git clone https://github.com/Mapika/decider.git\ncd decider\npip install -e \".[serve]\"\nscripts/serve.sh Mapika/decider-4b 8000",
      "von": "pip install von-sdk\nvon serve --host 127.0.0.1 --port 8000"
    },
    "ollamaDecisions": {
      "clef-flash": [
        "clef",
        "Clef Flash"
      ],
      "clef": [
        "clef",
        "Clef"
      ],
      "nimble": [
        "nimble",
        "Nimble"
      ],
      "laya": [
        "laya",
        "Laya"
      ],
      "tev1": [
        "tev1",
        "Tev1"
      ]
    }
  },
