{
  "manifest_version": 3,
  "name": "Muniment Browser Control",
  "version": "0.0.1",
  "minimum_chrome_version": "116",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://[::1]/*"],
  "background": {
    "service_worker": "dist/extension/service-worker.js",
    "type": "module"
  }
}
