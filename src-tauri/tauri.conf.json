{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "muniment",
  "version": "0.0.1",
  "identifier": "ai.muniment.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "muniment",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "asr-runtime/*": ".",
      "../docs/third-party/sherpa-onnx-NOTICE.md": "third-party/sherpa-onnx-NOTICE.md",
      "../docs/third-party/sherpa-onnx-LICENSE.txt": "third-party/sherpa-onnx-LICENSE.txt",
      "../docs/third-party/onnxruntime-LICENSE.txt": "third-party/onnxruntime-LICENSE.txt"
    },
    "targets": [
      "deb",
      "appimage",
      "app",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
