{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "launcher",
  "description": "The launcher exchanges thread requests with the main window and controls its own panel.",
  "windows": [
    "launcher"
  ],
  "permissions": [
    "core:event:default",
    "allow-launcher-start-failed",
    "allow-launcher-close",
    "allow-launcher-present-main"
  ]
}
