{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Baseline capability for the main window: core APIs. App-defined commands (auth_*) are not ACL-gated and need no entry here.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
