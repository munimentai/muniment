#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
  mkdir -p /etc/systemd/user/default.target.wants
  ln -sfn /usr/lib/systemd/user/muniment-runtime.service \
    /etc/systemd/user/default.target.wants/muniment-runtime.service
  # Tauri names the payload after the crate. The runtime admits a desktop
  # client only at bin/<productName>, so point that path at the payload.
  if [ -e /usr/bin/muniment-desktop ]; then
    if [ ! -e /usr/bin/muniment ] || [ -L /usr/bin/muniment ]; then
      ln -sfn muniment-desktop /usr/bin/muniment
    fi
  fi
fi

exit 0
