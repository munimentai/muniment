{
  "productName": "Muniment Browser Prototype",
  "version": "0.1.6",
  "identifier": "com.muniment.cef-prototype",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "frameworks": [
        "target/release/libmuniment_cef_keychain.dylib"
      ]
    }
  }
}
